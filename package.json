{
  "name": "mirage-event-planner",
  "version": "1.0.0",
  "main": "electron/main.cjs",
  "scripts": {
    "test": "vitest run",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server/index.js",
    "server:dev": "nodemon server/index.js",
    "desktop:dir": "npm run build && electron-builder --mac dir --x64",
    "desktop:pack": "npm run build && electron-builder --mac dmg --x64",
    "start": "node server/index.js",
    "db:migrate": "node server/db/migrate.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^22.3.27",
    "electron-builder": "^24.13.3",
    "nodemon": "^3.1.14",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "com.gabriela.mirage.desktop",
    "productName": "MIRAGE",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "artifactName": "MIRAGE-${version}-mac-intel.${ext}"
    },
    "directories": {
      "output": "release"
    }
  }
}
